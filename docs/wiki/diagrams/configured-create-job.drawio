        <mxCell id="subtitle" value="Gipter desktop application with a named run configuration already saved" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#465F70;" vertex="1" parent="1">
