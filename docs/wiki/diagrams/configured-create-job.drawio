        </mxCell>
        <mxCell id="clicking" value="&lt;b&gt;Clicking way&lt;/b&gt;&lt;br/&gt;Every week → choose a day of the week.&lt;br/&gt;Every 2 weeks → choose a start date.&lt;br/&gt;Every month → choose a day from 1 to 28.&lt;br/&gt;Set Exact time for the selected recurrence." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;strokeWidth=1.5;fontColor=#183749;" vertex="1" parent="1">
