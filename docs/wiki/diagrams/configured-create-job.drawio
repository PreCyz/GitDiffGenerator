        </mxCell>
        <mxCell id="signin" value="&lt;b&gt;Sign in to Toolkit&lt;/b&gt;&lt;br/&gt;Complete the work-account prompts&lt;br/&gt;and dismiss the confirmation." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;strokeWidth=1.5;fontColor=#183749;" vertex="1" parent="1">
