<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="configured-toolkit-upload" name="Upload with a saved configuration">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Upload with a saved configuration" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;align=left;verticalAlign=middle;spacing=0;fontSize=29;fontStyle=1;fontColor=#15354A;" vertex="1" parent="1">
          <mxGeometry x="32" y="20" width="776" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Manual upload of one copyright item from the Gipter desktop application" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#465F70;" vertex="1" parent="1">
          <mxGeometry x="32" y="66" width="776" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="launch" value="&lt;b&gt;Launch Gipter&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=50;fillColor=#21536B;strokeColor=#21536B;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="185" y="116" width="260" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;Toolkit sign-in&lt;/b&gt;&lt;br/&gt;requested?" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rhombus;fillColor=#FFF4D6;strokeColor=#B98927;strokeWidth=1.5;fontColor=#5C4214;" vertex="1" parent="1">
          <mxGeometry x="204" y="204" width="222" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="signin" value="&lt;b&gt;Sign in to Toolkit&lt;/b&gt;&lt;br/&gt;Complete the work-account prompts&lt;br/&gt;and dismiss the confirmation." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;strokeWidth=1.5;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="525" y="213" width="280" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="main" value="&lt;b&gt;Select the saved configuration&lt;/b&gt;&lt;br/&gt;In the main window, choose its Name under Configuration." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;strokeWidth=1.5;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="65" y="366" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="edge-launch-session" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=14;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#395666;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="launch" target="session">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-session-signin" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=14;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#395666;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="session" target="signin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-session-main" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=14;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#395666;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="session" target="main">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-signin-main" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=14;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#395666;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="signin" target="main">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="401"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;Review the upload&lt;/b&gt;&lt;br/&gt;Check the Toolkit folder and the Time frame for this item.&lt;br/&gt;Adjust the available dates if needed." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;strokeWidth=1.5;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="65" y="482" width="500" height="89" as="geometry"/>
        </mxCell>
        <mxCell id="execute" value="&lt;b&gt;Select Execute&lt;/b&gt;&lt;br/&gt;Gipter prepares the item and uploads its attachment." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;strokeWidth=1.5;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="65" y="617" width="500" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="success" value="&lt;b&gt;Copyright item uploaded to Toolkit&lt;/b&gt;&lt;br/&gt;The progress message reads “Finished with SUCCESS”." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;rounded=1;arcSize=50;fillColor=#DDF4E9;strokeColor=#298163;strokeWidth=2;fontColor=#144D3C;" vertex="1" parent="1">
          <mxGeometry x="65" y="740" width="500" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="edge-main-review" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=14;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#395666;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="main" target="review">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-review-execute" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=14;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#395666;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="review" target="execute">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-execute-success" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=14;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#395666;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="execute" target="success">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
