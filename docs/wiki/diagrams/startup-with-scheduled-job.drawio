<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="startup-with-scheduled-job" name="Run a saved job at Windows startup">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="990" pageHeight="1190" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Run a saved job at Windows startup" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;align=left;verticalAlign=middle;spacing=0;fontSize=29;fontStyle=1;fontColor=#15354A;" vertex="1" parent="1">
          <mxGeometry x="32" y="20" width="916" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Auto-start is enabled, and Gipter already has a saved upload job." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#465F70;" vertex="1" parent="1">
          <mxGeometry x="32" y="65" width="916" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;Start the computer and sign in to Windows&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=50;fillColor=#21536B;strokeColor=#21536B;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="120" y="115" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="launch" value="&lt;b&gt;Windows starts Gipter in the background&lt;/b&gt;&lt;br/&gt;Gipter checks the saved Toolkit session." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#7893A4;dashed=1;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="100" y="202" width="390" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;Sign-in&lt;/b&gt;&lt;br/&gt;requested?" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rhombus;fillColor=#FFF4D6;strokeColor=#B98927;fontColor=#5C4214;" vertex="1" parent="1">
          <mxGeometry x="180" y="307" width="230" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="signin" value="&lt;b&gt;Sign in to Toolkit&lt;/b&gt;&lt;br/&gt;Complete the Microsoft sign-in prompts&lt;br/&gt;and dismiss the confirmation." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="590" y="322" width="350" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="restore" value="&lt;b&gt;Gipter restores the saved schedule&lt;/b&gt;&lt;br/&gt;It checks whether an upload was missed." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#7893A4;dashed=1;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="100" y="448" width="390" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="missed" value="&lt;b&gt;Missed-run&lt;/b&gt;&lt;br/&gt;prompt shown?" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rhombus;fillColor=#FFF4D6;strokeColor=#B98927;fontColor=#5C4214;" vertex="1" parent="1">
          <mxGeometry x="168" y="562" width="254" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="prompt" value="&lt;b&gt;Review the missed upload&lt;/b&gt;&lt;br/&gt;Check the date range in the prompt. Choose&lt;br/&gt;Trigger now to upload it or Don’t to skip it." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="570" y="570" width="390" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;Leave Gipter running in the background&lt;/b&gt;&lt;br/&gt;The job runs at its next scheduled time.&lt;br/&gt;Missed cron runs also follow this path." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="85" y="727" width="420" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="catchup" value="&lt;b&gt;Gipter starts the missed run now&lt;/b&gt;&lt;br/&gt;It uses the saved job configurations&lt;br/&gt;and the date range from the prompt." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#7893A4;dashed=1;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="590" y="727" width="350" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;If Toolkit asks again, complete sign-in&lt;/b&gt;&lt;br/&gt;A valid session lets the job continue automatically." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#F4F8FB;strokeColor=#7893A4;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="235" y="862" width="500" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="upload" value="&lt;b&gt;Gipter runs the job&lt;/b&gt;&lt;br/&gt;It generates and uploads the item for each selected configuration." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#7893A4;dashed=1;fontColor=#183749;" vertex="1" parent="1">
          <mxGeometry x="235" y="976" width="500" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;Copyright items uploaded to Toolkit&lt;/b&gt;&lt;br/&gt;A successful run is recorded as SUCCESS." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;fontSize=16;strokeWidth=1.5;rounded=1;arcSize=50;fillColor=#DDF4E9;strokeColor=#298163;fontColor=#144D3C;" vertex="1" parent="1">
          <mxGeometry x="235" y="1083" width="500" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="boot-launch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="boot" target="launch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="launch-session" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="launch" target="session">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="session-signin" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="session" target="signin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="session-restore" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="session" target="restore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="signin-restore" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="signin" target="restore">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="485"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="restore-missed" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="restore" target="missed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="missed-prompt" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="missed" target="prompt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="missed-wait" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="missed" target="wait">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="prompt-catchup" value="Trigger now" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prompt" target="catchup">
