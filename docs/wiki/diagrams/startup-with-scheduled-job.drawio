        <mxCell id="prompt-wait" value="Don’t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prompt" target="wait">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="648" y="690"/><mxPoint x="421" y="690"/></Array></mxGeometry>
