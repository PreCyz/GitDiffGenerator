          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="837"/><mxPoint x="189" y="837"/><mxPoint x="189" y="900"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="catchup-auth" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="catchup" target="auth">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="900"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="auth-upload" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=12;html=1;strokeColor=#567385;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#395666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="upload">
